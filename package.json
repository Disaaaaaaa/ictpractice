{
  "name": "nis-cs-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:build": "tsx scripts/build-seed.ts",
    "curriculum:import": "python3 scripts/import_curriculum.py --grade11 docs/source/KTP_11_Computer_Science_2026-2027.docx --grade12 docs/source/KTP_12_Computer_Science_2026-2027.docx --papers docs/source/PAPER_1-2-3.docx",
    "users:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-users.ts",
    "import:html": "tsx --env-file-if-exists=.env.local scripts/import-html-theory.ts",
    "theory:apply": "tsx --env-file-if-exists=.env.local scripts/apply-theory.ts",
    "content:generate": "tsx --env-file-if-exists=.env.local scripts/generate-content.ts",
    "questions:apply": "tsx --env-file-if-exists=.env.local scripts/apply-questions.ts",
    "mocks:import": "tsx --env-file-if-exists=.env.local scripts/import-mocks.ts",
    "mocks:apply": "tsx --env-file-if-exists=.env.local scripts/apply-mocks.ts",
    "theory:build": "tsx --env-file-if-exists=.env.local scripts/build-theory.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^12.12.0",
    "exceljs": "^4.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.1.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "node-html-parser": "^9.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
