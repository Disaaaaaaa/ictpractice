  "summary": "Converting binary to hexadecimal and back, and the reasons hexadecimal is used in computer systems.",
  "theory": [
    {
      "title": "Converting binary to hexadecimal",
      "objectives": [
        "12.1.1.1"
      ],
      "blocks": [
        {
          "type": "paragraph",
          "content": "One hexadecimal digit represents exactly **4 bits** (a nibble), because 16 = 2⁴."
        },
        {
          "type": "comparison",
          "title": "Nibble ↔ hex",
          "columns": [
            "Binary",
            "Hex",
            "Binary",
            "Hex"
          ],
          "rows": [
            [
              "0000",
              "0",
              "1000",
              "8"
            ],
            [
              "0001",
              "1",
              "1001",
              "9"
            ],
            [
              "0010",
              "2",
              "1010",
              "A"
            ],
            [
              "0011",
              "3",
              "1011",
              "B"
            ],
