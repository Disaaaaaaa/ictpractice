      "blocks": [
        {
          "type": "steps",
          "title": "From expression to circuit: X = ¬((A + ¬B) · C)",
          "items": [
            "Innermost first: **NOT** gate on B → ¬B.",
            "**OR** gate with inputs A and ¬B → A + ¬B.",
            "**AND** gate with inputs (A + ¬B) and C.",
            "**NOT** on the result — or replace the last AND + NOT with one **NAND** gate."
          ]
        },
        {
          "type": "diagram",
