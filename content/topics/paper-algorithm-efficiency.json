            ],
            [
              "O(n)",
              "Linear",
              "**Linear search**; finding the maximum",
              "1000"
            ],
            [
              "O(n log n)",
              "Linearithmic",
              "Merge sort, quick sort (average)",
              "≈ 10 000"
            ],
            [
              "O(n²)",
              "Quadratic",
              "**Bubble sort**, **insertion sort**; nested loops",
              "1 000 000"
            ],
            [
              "O(2ⁿ)",
              "Exponential",
              "Trying every subset",
              "astronomically large"
