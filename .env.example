# --- Public (safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
# Usernames are turned into <username>@<domain> for Supabase Auth
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=students.internal
NEXT_PUBLIC_ACADEMIC_YEAR=2026-2027
NEXT_PUBLIC_TIMEZONE=Asia/Qyzylorda

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=<service role / secret key>
OPENAI_API_KEY=<openai key>
OPENAI_MODEL=gpt-5-mini
# Temporary password for new and reset accounts (must be changed at first login)
DEFAULT_TEMP_PASSWORD=111111
# Protects /api/cron/grade (Vercel sends it as "Authorization: Bearer <secret>")
CRON_SECRET=<long random string>

# Model for npm run content:generate (theory and questions)
CONTENT_MODEL=gpt-5.5
